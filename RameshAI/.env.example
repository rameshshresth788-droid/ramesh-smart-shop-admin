# This file documents the runtime config keys. It is NOT read directly by the app.
# Real values live in the app's runtime config (config/assistant.json), edited via
# the in-app Settings screen or tools/config.sh — never committed to git.

AI_PROVIDER=openai            # openai | gemini | openrouter | local
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-REPLACE_ME
AI_MODEL=gpt-4o-mini
ASSISTANT_NAME=RAMESH
WAKE_PHRASE=RAMESH AI
LANGUAGE=hi-IN
SYSTEM_PROMPT="You are RAMESH's private personal AI assistant..."
NEWS_PROVIDER=none
DEBUG_MODE=false
